# =============================================================================
# Handla — ROOT .env  (Docker Compose interpolation only)
# =============================================================================
# Docker Compose reads THIS file (the repo-root ./.env) to resolve the
# ${VARS} written inside docker-compose.yml (mysql credentials, api port, etc).
# It is SEPARATE from handla-backend/.env, which holds the application secrets
# the API process itself reads at runtime.
#
# ON THE VPS you normally DON'T create this by hand — `deploy/deploy.sh`
# generates ./.env automatically from handla-backend/.env so there is a single
# source of truth. This template exists for documentation / manual runs.
#
#   cp .env.example .env      # then fill in, OR let deploy.sh generate it
#
# The values below MUST match the same keys in handla-backend/.env.
# =============================================================================

# API port (kept internal; nginx proxies to it). Default 3001.
PORT=3001

# ─── MySQL (must match handla-backend/.env) ──────────────────────────────────
DATABASE_NAME=handla_db
# RUNTIME identity (DML-only). Canonical: handla_runtime.
# The legacy `handla` user is DEPRECATED and scheduled for removal.
DATABASE_USER=handla_runtime
DATABASE_PASSWORD=__SAME_AS_handla-backend/.env__
DATABASE_ROOT_PASSWORD=__SAME_AS_handla-backend/.env__
# Migrator identity (schema-scoped DDL, migrations only). Canonical: handla_migrator.
DATABASE_MIGRATION_USER=handla_migrator
DATABASE_MIGRATION_PASSWORD=__SAME_AS_handla-backend/.env__

# ─── Schema sync — ALWAYS false in production (migrations run on api boot) ────
DATABASE_SYNCHRONIZE=false
