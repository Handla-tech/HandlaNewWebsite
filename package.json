{
  "name": "handla",
  "version": "1.0.0",
  "description": "Handla — Full-Stack Software Services Marketing Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd handla-frontend && npm run dev",
    "dev:backend": "cd handla-backend && npm run start:dev",
    "build": "cd handla-backend && npm run build && cd ../handla-frontend && npm run build",
    "build:frontend": "cd handla-frontend && npm run build",
    "build:backend": "cd handla-backend && npm run build",
    "install:all": "npm i && cd handla-frontend && npm i && cd ../handla-backend && npm i",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "jest-cli": "^30.4.2",
    "ts-jest": "^29.4.11"
  }
}
