#!/usr/bin/env bash
# =============================================================================
# handla-production-deploy  —  root-owned fixed production deployment wrapper
# =============================================================================
# INSTALLED AT (on the VPS):  /usr/local/sbin/handla-production-deploy
# OWNER/MODE:                 root:root 0755  (handla-deploy has NO write access)
# INVOKED BY:                 handla-deploy, via a single narrow sudo rule:
#     handla-deploy ALL=(root) NOPASSWD: /usr/local/sbin/handla-production-deploy
#
# PURPOSE
#   Replace `handla-deploy`'s membership of the `docker` group (which is
#   root-equivalent on the host) with the ability to run EXACTLY ONE fixed,
#   root-owned production-deploy sequence. The deploy user cannot:
#     - run arbitrary docker/compose commands
#     - pass arbitrary arguments, paths, branches, or compose files
#     - modify the code this script executes (trusted checkout is root-owned)
#
# TRUST BOUNDARY (Phase 7 — CRITICAL)
#   The application working tree at /opt/handla is WRITABLE by handla-deploy.
#   Executing deploy logic from there as root would re-introduce root code
#   execution for handla-deploy. Therefore this wrapper deploys ONLY from a
#   SEPARATE, ROOT-OWNED trusted checkout at $TRUSTED_DIR, which it fetches and
#   hard-resets to origin/main itself. handla-deploy cannot write to it.
#
#   The security boundary becomes:
#       authorization to push to GitHub 'main'  ->  production deployment
#   NOT:
#       SSH as handla-deploy  ->  arbitrary root code execution
#
# HARD-CODED, NON-OVERRIDABLE POLICY
#   - Repository : $EXPECTED_REMOTE   (verified every run)
#   - Branch     : main               (never a parameter)
#   - Directory  : /opt/handla-production (root-owned; never a parameter)
#   This script accepts NO positional arguments and NO deploy-controlling env.
# =============================================================================

set -euo pipefail

# ---- 0. Sanitised, fixed execution environment -----------------------------
# Explicit safe PATH (absolute, root-controlled dirs only). Do NOT inherit the
# caller's PATH — that would allow PATH hijacking of git/docker/etc.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022
# Drop anything that could redirect git/ssh/compose behaviour from the caller.
unset BASH_ENV ENV CDPATH IFS \
      GIT_DIR GIT_WORK_TREE GIT_SSH GIT_SSH_COMMAND GIT_CONFIG GIT_CONFIG_GLOBAL \
      GIT_EXEC_PATH GIT_TEMPLATE_DIR GIT_ALTERNATE_OBJECT_DIRECTORIES \
      DOCKER_HOST DOCKER_CONFIG DOCKER_CONTEXT DOCKER_CERT_PATH DOCKER_TLS_VERIFY \
      LD_PRELOAD LD_LIBRARY_PATH PYTHONPATH NODE_OPTIONS \
      COMPOSE_FILE COMPOSE_PROJECT_NAME HANDLA_DIR PULL DEPLOY_BRANCH \
      BASH_FUNC_docker%% BASH_FUNC_git%% 2>/dev/null || true

# ---- 1. Reject ALL arguments (no attacker-controlled input) ----------------
if [ "$#" -ne 0 ]; then
  echo "[handla-production-deploy] FATAL: this command takes no arguments." >&2
  echo "[handla-production-deploy]        It always deploys origin/main from the trusted checkout." >&2
  exit 64
fi

# ---- 2. Fixed policy constants (NOT overridable from the environment) ------
readonly EXPECTED_REMOTE="https://github.com/Handla-tech/HandlaNewWebsite.git"
readonly BRANCH="main"
readonly TRUSTED_DIR="/opt/handla-production"
readonly SECRETS_ENV="/opt/handla-production-secrets/backend.env"   # root:root 600
readonly BACKEND_ENV_REL="handla-backend/.env"
readonly COMPOSE_FILES=( -f docker-compose.yml -f deploy/docker-compose.traefik.yml )
readonly GIT=/usr/bin/git
readonly DOCKER=/usr/bin/docker
readonly NODE=/usr/bin/node
readonly TRAEFIK_NETWORK="proxy"
# Pin the Compose PROJECT NAME explicitly. Compose otherwise derives it from the
# working-directory basename; because the trusted checkout lives in
# /opt/handla-production (not /opt/handla), an un-pinned project name would
# create a SEPARATE stack ("handla-production_*") with fresh, empty mysql/redis
# volumes and a new network — a silent data-separation regression. Pin it to the
# original production project so the existing handla_* volumes/network are reused.
readonly COMPOSE_PROJECT="handla"
readonly ROLLBACK_DIR="/opt/handla-production-rollback"
readonly ROLLBACK_OVERRIDE="$ROLLBACK_DIR/docker-compose.rollback.yml"
readonly ROLLBACK_METADATA="$ROLLBACK_DIR/rollback-state.json"
readonly BACKUP_STATE_DIR="/var/lib/handla-backup"
readonly BACKUP_SUCCESS_MARKER="$BACKUP_STATE_DIR/last-success"
readonly BACKUP_SUCCESS_META="$BACKUP_STATE_DIR/last-success.meta"

CALLER="${SUDO_USER:-$(id -un)}"
log() { echo "[handla-production-deploy] $*"; }

log "Initiated by user='${CALLER}' (uid=$(id -u)) at $(date -u +%FT%TZ)"

# Track whether application containers are in a dangerous/unverified state
APP_DEPLOY_IN_PROGRESS=0
APP_CLEANUP_EXECUTED=0

# Clean up ONLY handla_api and handla_web if startup, healthcheck, or interruption occurs.
#
# LIMITATIONS OF SHELL TRAPS:
# Shell traps (INT, TERM, HUP, EXIT) cannot intercept SIGKILL (kill -9) or abrupt
# hardware/hypervisor host power loss. In those uncatchable events, Docker daemon
# state persists across host reboot and containers may need manual operator inspection.
cleanup_application_containers() {
  local incoming_exit="${1:-$?}"

  # Ensure cleanup runs at most once
  if [ "$APP_CLEANUP_EXECUTED" -eq 1 ]; then
    return "$incoming_exit"
  fi

  if [ "$APP_DEPLOY_IN_PROGRESS" -eq 1 ]; then
    APP_CLEANUP_EXECUTED=1
    APP_DEPLOY_IN_PROGRESS=0
    log "CRITICAL / FAILURE: Deployment did not complete verification. Initiating strict application container cleanup..."

    # 1. Stop only application containers (never mysql, redis, or traefik)
    "$DOCKER" stop handla_api handla_web >/dev/null 2>&1 || true

    # 2. Strict verification: both application containers MUST be in an explicitly safe
    # stopped state ("exited", or "not_found" if not yet created).
    # Any other status ("running", "restarting", "paused", "created", "removing",
    # "dead", "unknown", or inspection failure) is treated as unsafe/inconclusive.
    local api_inspect_err=0
    local web_inspect_err=0
    local api_status
    local web_status

    api_status="$("$DOCKER" inspect --format='{{.State.Status}}' handla_api 2>/dev/null)" || api_inspect_err=$?
    web_status="$("$DOCKER" inspect --format='{{.State.Status}}' handla_web 2>/dev/null)" || web_inspect_err=$?

    # If inspect command failed because container doesn't exist, classify as not_found
    if [ "$api_inspect_err" -ne 0 ]; then
      api_status="not_found"
    fi
    if [ "$web_inspect_err" -ne 0 ]; then
      web_status="not_found"
    fi

    local api_safe=0
    local web_safe=0

    if [ "$api_status" = "exited" ] || [ "$api_status" = "not_found" ]; then
      api_safe=1
    fi
    if [ "$web_status" = "exited" ] || [ "$web_status" = "not_found" ]; then
      web_safe=1
    fi

    if [ "$api_safe" -ne 1 ] || [ "$web_safe" -ne 1 ]; then
      echo "[handla-production-deploy] CRITICAL: Failed to verify safe container shutdown!" >&2
      echo "[handla-production-deploy]           handla_api: status='${api_status}' (safe: ${api_safe})" >&2
      echo "[handla-production-deploy]           handla_web: status='${web_status}' (safe: ${web_safe})" >&2
      echo "[handla-production-deploy]           Containers are NOT in an explicitly safe state ('exited' or 'not_found')." >&2
      echo "[handla-production-deploy]           Manual intervention required immediately: run 'docker stop -t 10 handla_api handla_web'." >&2
      exit 99
    fi

    log "Application containers confirmed in safe stopped state (handla_api: ${api_status}, handla_web: ${web_status}) ✓"
    log "Core stateful services (handla_mysql, handla_redis) preserved untouched ✓"
  fi

  return "$incoming_exit"
}

# Signal handlers: perform cleanup and terminate with standard Unix 128 + signal code
on_sigint() {
  trap - INT EXIT
  log "Interrupted by SIGINT. Terminating deployment..."
  cleanup_application_containers 130
  exit 130
}

on_sigterm() {
  trap - TERM EXIT
  log "Terminated by SIGTERM. Terminating deployment..."
  cleanup_application_containers 143
  exit 143
}

on_sighup() {
  trap - HUP EXIT
  log "Disconnected by SIGHUP. Terminating deployment..."
  cleanup_application_containers 129
  exit 129
}

on_exit() {
  local code=$?
  trap - EXIT
  if [ "$code" -eq 0 ] && [ "$APP_DEPLOY_IN_PROGRESS" -eq 1 ]; then
    code=8
  fi
  cleanup_application_containers "$code"
  exit "$code"
}

trap on_sigint INT
trap on_sigterm TERM
trap on_sighup HUP
trap on_exit EXIT

# ---- 3. Must run as root (via sudo) ----------------------------------------
if [ "$(id -u)" -ne 0 ]; then
  echo "[handla-production-deploy] FATAL: must run as root (via sudo)." >&2
  exit 1
fi

# ---- 4. Ensure/repair the root-owned trusted checkout ----------------------
# The trusted checkout and its parent MUST be root-owned and not writable by
# handla-deploy. We verify this every run and refuse to proceed otherwise.
if [ ! -d "$TRUSTED_DIR/.git" ]; then
  log "Trusted checkout missing; creating a fresh clone of ${BRANCH}..."
  install -d -m 0755 -o root -g root "$TRUSTED_DIR"
  "$GIT" -c safe.directory="$TRUSTED_DIR" clone --branch "$BRANCH" --single-branch \
        "$EXPECTED_REMOTE" "$TRUSTED_DIR"
fi

# Ownership / writability guard on the trusted checkout (defence in depth).
owner="$(stat -c '%U' "$TRUSTED_DIR")"
if [ "$owner" != "root" ]; then
  echo "[handla-production-deploy] FATAL: trusted checkout '$TRUSTED_DIR' is owned by '$owner', not root." >&2
  exit 3
fi
# Refuse if group/other-writable, or if handla-deploy owns any tracked path.
if find "$TRUSTED_DIR" -maxdepth 2 \( -perm -0020 -o -perm -0002 \) -print -quit | grep -q .; then
  echo "[handla-production-deploy] FATAL: trusted checkout contains group/other-writable paths." >&2
  exit 3
fi

cd "$TRUSTED_DIR"
export GIT_CONFIG_GLOBAL=/dev/null   # ignore any global git config for these ops
GITC=("$GIT" -c safe.directory="$TRUSTED_DIR" -c core.hooksPath=/dev/null)

# ---- 5. Verify the remote is the expected repository -----------------------
actual_remote="$("${GITC[@]}" remote get-url origin 2>/dev/null || echo none)"
if [ "$actual_remote" != "$EXPECTED_REMOTE" ]; then
  log "Remote mismatch ('$actual_remote'); pinning origin to expected repository."
  "${GITC[@]}" remote set-url origin "$EXPECTED_REMOTE"
fi

# ---- 6. Fetch and hard-reset to origin/main (trusted content only) ---------
# core.hooksPath=/dev/null ⇒ no repo-controlled git hooks execute here.
log "Fetching origin/${BRANCH}..."
"${GITC[@]}" fetch --prune --no-tags origin "$BRANCH"
log "Hard-resetting trusted checkout to origin/${BRANCH}..."
"${GITC[@]}" checkout -B "$BRANCH" "origin/$BRANCH"
"${GITC[@]}" reset --hard "origin/$BRANCH"
# Remove untracked files (e.g. a planted executable) but KEEP nothing user-supplied.
"${GITC[@]}" clean -ffd
DEPLOY_SHA="$("${GITC[@]}" rev-parse --short HEAD)"
log "Trusted checkout now at ${BRANCH}@${DEPLOY_SHA}"

# ---- 7. Provision backend secrets into the trusted checkout ----------------
# Secrets are NOT in git. The authoritative copy is root-owned at $SECRETS_ENV
# (handla-deploy cannot modify it). Copy it into the trusted tree at 600.
if [ ! -f "$SECRETS_ENV" ]; then
  echo "[handla-production-deploy] FATAL: root-owned secrets file '$SECRETS_ENV' is missing." >&2
  echo "[handla-production-deploy]        Seed it once from the previous handla-backend/.env (root:root 0600)." >&2
  exit 4
fi
install -D -m 0600 -o root -g root "$SECRETS_ENV" "$TRUSTED_DIR/$BACKEND_ENV_REL"
log "Backend .env provisioned from root-owned secrets store."

# ---- 8. Run the fixed production deploy sequence ---------------------------
# We execute the Docker operations here (from the trusted, root-owned tree),
# mirroring deploy/deploy.traefik.sh but WITHOUT sourcing the user-writable
# copy. PULL=0 because this wrapper already controls the git state itself.
export TRAEFIK_NETWORK TRAEFIK_CERTRESOLVER="letsencrypt" TRAEFIK_ENTRYPOINT="websecure"
# Force the original production project name so existing handla_* volumes and the
# handla_handla_net network are reused (see COMPOSE_PROJECT rationale above).
export COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT"

log "Verifying backend .env exists..."
[ -f "$BACKEND_ENV_REL" ] || { echo "[handla-production-deploy] FATAL: backend .env missing after provisioning." >&2; exit 4; }

log "Generating root ./.env for Docker Compose interpolation..."
get() { grep -E "^$1=" "$BACKEND_ENV_REL" | tail -n1 | cut -d= -f2- || true; }
{
  echo "# AUTO-GENERATED by handla-production-deploy (root wrapper) from $BACKEND_ENV_REL"
  echo "PORT=$(get PORT)"
  echo "DATABASE_NAME=$(get DATABASE_NAME)"
  echo "DATABASE_USER=$(get DATABASE_USER)"
  echo "DATABASE_PASSWORD=$(get DATABASE_PASSWORD)"
  echo "DATABASE_ROOT_PASSWORD=$(get DATABASE_ROOT_PASSWORD)"
  echo "DATABASE_SYNCHRONIZE=$(get DATABASE_SYNCHRONIZE)"
  echo "DATABASE_MIGRATION_USER=$(get DATABASE_MIGRATION_USER)"
  echo "DATABASE_MIGRATION_PASSWORD=$(get DATABASE_MIGRATION_PASSWORD)"
  echo "REDIS_USERNAME=$(get REDIS_USERNAME)"
  echo "REDIS_PASSWORD=$(get REDIS_PASSWORD)"
} > .env
grep -q '^REDIS_USERNAME=.\+'      .env || sed -i 's|^REDIS_USERNAME=.*|REDIS_USERNAME=handla_app|' .env
grep -q '^PORT=.\+'                .env || sed -i 's|^PORT=.*|PORT=3001|'                           .env
grep -q '^DATABASE_NAME=.\+'       .env || sed -i 's|^DATABASE_NAME=.*|DATABASE_NAME=handla_db|'    .env
# Runtime DB identity MUST be present in the source secrets. Never silently
# fall back to the deprecated privileged legacy `handla` user: fail clearly so a
# missing secret is a visible deployment error, not an obsolete-identity boot.
grep -q '^DATABASE_USER=.\+'       .env || { echo "[handla-production-deploy] FATAL: DATABASE_USER missing from $BACKEND_ENV_REL (canonical: handla_runtime). Refusing to deploy with a legacy/empty DB identity." >&2; exit 5; }

# Fail closed if migration credentials are missing or empty
grep -q '^DATABASE_MIGRATION_USER=.\+' .env || { echo "[handla-production-deploy] FATAL: DATABASE_MIGRATION_USER missing from $BACKEND_ENV_REL. Refusing to deploy without migration credentials." >&2; exit 5; }
grep -q '^DATABASE_MIGRATION_PASSWORD=.\+' .env || { echo "[handla-production-deploy] FATAL: DATABASE_MIGRATION_PASSWORD missing from $BACKEND_ENV_REL. Refusing to deploy without migration password." >&2; exit 5; }

grep -q '^DATABASE_SYNCHRONIZE=.\+' .env || sed -i 's|^DATABASE_SYNCHRONIZE=.*|DATABASE_SYNCHRONIZE=false|' .env
chmod 600 .env

log "Removing Handla's own nginx/certbot if present (Traefik handles TLS)..."
"$DOCKER" rm -f handla_nginx handla_certbot >/dev/null 2>&1 || true

log "Verifying Traefik external network '${TRAEFIK_NETWORK}' exists..."
if ! "$DOCKER" network inspect "${TRAEFIK_NETWORK}" >/dev/null 2>&1; then
  echo "[handla-production-deploy] FATAL: external network '${TRAEFIK_NETWORK}' not found." >&2
  exit 5
fi

COMPOSE_ARGS=( -p "$COMPOSE_PROJECT" "${COMPOSE_FILES[@]}" )

# ---- 8b. Validate Traefik Phase 1 Quarantine on merged Compose config --------
log "Validating effective Traefik Phase 1 quarantine configuration..."
COMPOSE_CONFIG_JSON="$("$DOCKER" compose "${COMPOSE_ARGS[@]}" config --format json 2>/dev/null || true)"
if [ -z "$COMPOSE_CONFIG_JSON" ]; then
  echo "[handla-production-deploy] FATAL: Failed to render effective Docker Compose configuration." >&2
  exit 5
fi

# Run a deterministic, fail-closed validator in Node.js
# - Parses JSON configuration safely
# - Verifies both API and Web have active Traefik routers
# - Verifies that both services independently define the exact approved allowlist (127.0.0.1/32)
# - Verifies that EVERY router declared on api and web has 'handla-quarantine' attached
# - Verifies that handla-web preserves 'handla-www-redirect'
# - Exits 0 on success; exits non-zero with explicit error message on any discrepancy or parsing failure
VALIDATOR_ERR="$("$NODE" -e '
  const fs = require("fs");
  try {
    const raw = fs.readFileSync(0, "utf-8");
    if (!raw || !raw.trim()) {
      console.error("Empty Docker Compose configuration JSON received.");
      process.exit(1);
    }
    const cfg = JSON.parse(raw);
    const services = cfg.services || {};

    const api = services.api;
    const web = services.web;
    if (!api || !web) {
      console.error("Missing api or web service definition in rendered compose config.");
      process.exit(1);
    }

    const apiLabels = api.labels || {};
    const webLabels = web.labels || {};

    const expectedAllow = "127.0.0.1/32";
    const apiAllowed = apiLabels["traefik.http.middlewares.handla-quarantine.ipallowlist.sourcerange"];
    const webAllowed = webLabels["traefik.http.middlewares.handla-quarantine.ipallowlist.sourcerange"];

    if (apiAllowed !== expectedAllow) {
      console.error(`api service middleware handla-quarantine sourcerange mismatch: expected "${expectedAllow}", got "${apiAllowed}"`);
      process.exit(1);
    }

    if (webAllowed !== expectedAllow) {
      console.error(`web service middleware handla-quarantine sourcerange mismatch: expected "${expectedAllow}", got "${webAllowed}"`);
      process.exit(1);
    }

    // Check routers on both services
    for (const [svcName, labels] of [["api", apiLabels], ["web", webLabels]]) {
      const routerNames = Object.keys(labels)
        .filter(k => k.startsWith("traefik.http.routers.") && k.endsWith(".rule"))
        .map(k => k.replace("traefik.http.routers.", "").replace(".rule", ""));

      if (routerNames.length === 0) {
        console.error(`No Traefik routers found on ${svcName} service.`);
        process.exit(1);
      }

      for (const router of routerNames) {
        const mwKey = `traefik.http.routers.${router}.middlewares`;
        const mwValue = labels[mwKey] || "";
        const mws = mwValue.split(",").map(s => s.trim()).filter(Boolean);
        if (!mws.includes("handla-quarantine")) {
          console.error(`Router "${router}" on service "${svcName}" lacks required "handla-quarantine" middleware.`);
          process.exit(1);
        }
      }
    }

    // Verify www-redirect preservation on web
    const webMainMw = webLabels["traefik.http.routers.handla-web.middlewares"] || "";
    const webMws = webMainMw.split(",").map(s => s.trim());
    if (!webMws.includes("handla-www-redirect")) {
      console.error("handla-web router is missing required handla-www-redirect middleware.");
      process.exit(1);
    }

    process.exit(0);
  } catch (err) {
    console.error("Validator exception:", err.message);
    process.exit(1);
  }
' <<< "$COMPOSE_CONFIG_JSON" 2>&1)" || {
  echo "[handla-production-deploy] FATAL: Traefik Phase 1 quarantine validation failed." >&2
  echo "[handla-production-deploy]        $VALIDATOR_ERR" >&2
  exit 5
}

log "Traefik Phase 1 quarantine verified on all Handla routers (127.0.0.1/32) ✓"

# ---- 9. Ensure core stateful infrastructure (MySQL & Redis) is running ------
log "Verifying status of core stateful services (mysql, redis)..."
MYSQL_STATE="$("$DOCKER" inspect --format='{{json .State.Status}}' handla_mysql 2>/dev/null || echo '"not_found"')"
MYSQL_HEALTH="$("$DOCKER" inspect --format='{{if .State.Health}}{{json .State.Health.Status}}{{else}}"none"{{end}}' handla_mysql 2>/dev/null || echo '"unknown"')"

REDIS_STATE="$("$DOCKER" inspect --format='{{json .State.Status}}' handla_redis 2>/dev/null || echo '"not_found"')"
REDIS_HEALTH="$("$DOCKER" inspect --format='{{if .State.Health}}{{json .State.Health.Status}}{{else}}"none"{{end}}' handla_redis 2>/dev/null || echo '"unknown"')"

if [ "$MYSQL_STATE" != '"running"' ] || [ "$MYSQL_HEALTH" != '"healthy"' ]; then
  echo "[handla-production-deploy] FATAL: handla_mysql is not running and healthy (status=${MYSQL_STATE}, health=${MYSQL_HEALTH})." >&2
  echo "[handla-production-deploy]        Core stateful containers must exist, be running, and report healthy before deployment." >&2
  echo "[handla-production-deploy]        Infrastructure bootstrap is a separate, explicitly authorized operation." >&2
  echo "[handla-production-deploy]        Refusing to execute 'docker compose up' against mysql." >&2
  exit 6
fi

if [ "$REDIS_STATE" != '"running"' ] || [ "$REDIS_HEALTH" != '"healthy"' ]; then
  echo "[handla-production-deploy] FATAL: handla_redis is not running and healthy (status=${REDIS_STATE}, health=${REDIS_HEALTH})." >&2
  echo "[handla-production-deploy]        Core stateful containers must exist, be running, and report healthy before deployment." >&2
  echo "[handla-production-deploy]        Infrastructure bootstrap is a separate, explicitly authorized operation." >&2
  echo "[handla-production-deploy]        Refusing to execute 'docker compose up' against redis." >&2
  exit 6
fi

log "Core stateful services (handla_mysql, handla_redis) are running and healthy ✓"
log "Preserving existing stateful containers (never executing docker compose up against mysql/redis during deployment)."

# ---- 10. Build application images -------------------------------------------
log "Building application images (api, web)..."
"$DOCKER" compose "${COMPOSE_ARGS[@]}" build api web

# Capture candidate prior image IDs from existing containers
CANDIDATE_API_IMAGE="$("$DOCKER" inspect --format='{{.Image}}' handla_api 2>/dev/null || true)"
CANDIDATE_WEB_IMAGE="$("$DOCKER" inspect --format='{{.Image}}' handla_web 2>/dev/null || true)"

# Read existing verified metadata if available:
# - active_*_image: the last successfully deployed & verified version (e.g. V1)
# - known_good_*_image / previous_*_image: the version before that (e.g. V0)
LAST_ACTIVE_API=""
LAST_ACTIVE_WEB=""
PREVIOUS_GOOD_API=""
PREVIOUS_GOOD_WEB=""
LAST_STATUS=""
if [ -f "$ROLLBACK_METADATA" ]; then
  LAST_STATUS="$(grep -m1 '"status":' "$ROLLBACK_METADATA" | sed -E 's/.*"status":[[:space:]]*"([^"]+)".*/\1/' || true)"
  LAST_ACTIVE_API="$(grep -m1 '"active_api_image":' "$ROLLBACK_METADATA" | sed -E 's/.*"active_api_image":[[:space:]]*"([^"]+)".*/\1/' || true)"
  LAST_ACTIVE_WEB="$(grep -m1 '"active_web_image":' "$ROLLBACK_METADATA" | sed -E 's/.*"active_web_image":[[:space:]]*"([^"]+)".*/\1/' || true)"

  PREVIOUS_GOOD_API="$(grep -m1 '"known_good_api_image":' "$ROLLBACK_METADATA" | sed -E 's/.*"known_good_api_image":[[:space:]]*"([^"]+)".*/\1/' || true)"
  [ -n "$PREVIOUS_GOOD_API" ] || PREVIOUS_GOOD_API="$(grep -m1 '"previous_api_image":' "$ROLLBACK_METADATA" | sed -E 's/.*"previous_api_image":[[:space:]]*"([^"]+)".*/\1/' || true)"

  PREVIOUS_GOOD_WEB="$(grep -m1 '"known_good_web_image":' "$ROLLBACK_METADATA" | sed -E 's/.*"known_good_web_image":[[:space:]]*"([^"]+)".*/\1/' || true)"
  [ -n "$PREVIOUS_GOOD_WEB" ] || PREVIOUS_GOOD_WEB="$(grep -m1 '"previous_web_image":' "$ROLLBACK_METADATA" | sed -E 's/.*"previous_web_image":[[:space:]]*"([^"]+)".*/\1/' || true)"
fi

# Verify runtime health of existing containers (requires both container health and HTTP 200)
CURR_API_IS_HEALTHY=0
CURR_WEB_IS_HEALTHY=0

c_api_health="$("$DOCKER" inspect --format='{{if .State.Health}}{{json .State.Health.Status}}{{else}}"none"{{end}}' handla_api 2>/dev/null || echo '"unknown"')"
c_web_state="$("$DOCKER" inspect --format='{{json .State.Status}}' handla_web 2>/dev/null || echo '"unknown"')"

if [ "$c_api_health" = '"healthy"' ] && \
   { curl -sf -o /dev/null -w "%{http_code}" --max-time 2 http://127.0.0.1:3001/api/health 2>/dev/null | grep -q "^200$" || \
     { [ -x "$NODE" ] && "$NODE" -e 'const http = require("http"); const req = http.get("http://127.0.0.1:3001/api/health", { timeout: 2000 }, (res) => process.exit(res.statusCode === 200 ? 0 : 1)); req.on("error", () => process.exit(1)); req.on("timeout", () => { req.destroy(); process.exit(1); });' 2>/dev/null; } || \
     "$DOCKER" exec handla_api wget -q -S --spider http://127.0.0.1:3001/api/health 2>&1 | grep -Eq 'HTTP/[0-9.]+ 200'; }; then
  CURR_API_IS_HEALTHY=1
fi

if [ "$c_web_state" = '"running"' ] && \
   { curl -sf -o /dev/null -w "%{http_code}" --max-time 2 http://127.0.0.1:3000/ 2>/dev/null | grep -q "^200$" || \
     { [ -x "$NODE" ] && "$NODE" -e 'const http = require("http"); const req = http.get("http://127.0.0.1:3000/", { timeout: 2000 }, (res) => process.exit(res.statusCode === 200 ? 0 : 1)); req.on("error", () => process.exit(1)); req.on("timeout", () => { req.destroy(); process.exit(1); });' 2>/dev/null; } || \
     "$DOCKER" exec handla_web node -e 'const http = require("http"); const req = http.get("http://127.0.0.1:3000/", { timeout: 2000 }, (res) => process.exit(res.statusCode === 200 ? 0 : 1)); req.on("error", () => process.exit(1)); req.on("timeout", () => { req.destroy(); process.exit(1); });' 2>/dev/null || \
     "$DOCKER" exec handla_web wget -q -S --spider http://127.0.0.1:3000/ 2>&1 | grep -Eq 'HTTP/[0-9.]+ 200'; }; then
  CURR_WEB_IS_HEALTHY=1
fi

# Determine authoritative prior rollback target images
ROLLBACK_TARGET_API=""
ROLLBACK_TARGET_WEB=""
ROLLBACK_BASELINE_STATUS=""
FIRST_DEPLOY_NO_BASELINE=0

if [ "$CURR_API_IS_HEALTHY" -eq 1 ] && [ "$CURR_WEB_IS_HEALTHY" -eq 1 ] && \
   [ -n "$CANDIDATE_API_IMAGE" ] && [ -n "$CANDIDATE_WEB_IMAGE" ]; then
  # Running containers pass active live HTTP 200 health checks -> use them directly as verified baseline
  ROLLBACK_TARGET_API="$CANDIDATE_API_IMAGE"
  ROLLBACK_TARGET_WEB="$CANDIDATE_WEB_IMAGE"
  ROLLBACK_BASELINE_STATUS="live_healthy"
elif [ -n "$LAST_ACTIVE_API" ] && [ -n "$LAST_ACTIVE_WEB" ]; then
  # Containers are stopped, unverified, or broken by a failed deploy -> prefer the LAST VERIFIED ACTIVE version
  ROLLBACK_TARGET_API="$LAST_ACTIVE_API"
  ROLLBACK_TARGET_WEB="$LAST_ACTIVE_WEB"
  ROLLBACK_BASELINE_STATUS="last_verified_active"
elif [ -n "$PREVIOUS_GOOD_API" ] && [ -n "$PREVIOUS_GOOD_WEB" ]; then
  # Fallback to earlier known-good if last_active is somehow not present in legacy metadata
  ROLLBACK_TARGET_API="$PREVIOUS_GOOD_API"
  ROLLBACK_TARGET_WEB="$PREVIOUS_GOOD_WEB"
  ROLLBACK_BASELINE_STATUS="${LAST_STATUS:-persisted_known_good}"
elif [ -n "$CANDIDATE_API_IMAGE" ] && [ -n "$CANDIDATE_WEB_IMAGE" ]; then
  # Check if candidate images actually exist in local Docker storage
  api_exists=0
  web_exists=0
  "$DOCKER" image inspect "$CANDIDATE_API_IMAGE" >/dev/null 2>&1 && api_exists=1 || true
  "$DOCKER" image inspect "$CANDIDATE_WEB_IMAGE" >/dev/null 2>&1 && web_exists=1 || true

  if [ "$api_exists" -eq 1 ] && [ "$web_exists" -eq 1 ]; then
    # Both historical candidate images exist in local Docker storage -> usable unverified baseline
    ROLLBACK_TARGET_API="$CANDIDATE_API_IMAGE"
    ROLLBACK_TARGET_WEB="$CANDIDATE_WEB_IMAGE"
    ROLLBACK_BASELINE_STATUS="initial_unverified_baseline"
  elif [ "$api_exists" -eq 0 ] && [ "$web_exists" -eq 0 ]; then
    # Neither historical image exists in local Docker storage.
    # Check eligibility for explicit first-deployment / no-baseline mode.
    # Strict eligibility conditions:
    # 1. Existing application containers must be stopped ('exited' or 'not_found').
    # 2. Historical images must genuinely be unavailable.
    # 3. No valid rollback baseline or metadata exists in /opt/handla-production-rollback.
    # 4. Production Traefik quarantine must pass effective Compose validation (verified in Step 8b).
    # 5. The required database backup must exist and pass integrity checks.

    log "Checking eligibility for first-deployment (no historical rollback baseline) mode..."

    api_raw_status="$("$DOCKER" inspect --format='{{.State.Status}}' handla_api 2>/dev/null || echo 'not_found')"
    web_raw_status="$("$DOCKER" inspect --format='{{.State.Status}}' handla_web 2>/dev/null || echo 'not_found')"

    if [ "$api_raw_status" = "running" ] || [ "$web_raw_status" = "running" ]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: application containers are currently running." >&2
      echo "[handla-production-deploy]        (handla_api: ${api_raw_status}, handla_web: ${web_raw_status})." >&2
      exit 9
    fi

    # Confirm no rollback metadata or overrides exist
    if [ -f "$ROLLBACK_METADATA" ] || [ -f "$ROLLBACK_OVERRIDE" ]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: rollback metadata or override exists in ${ROLLBACK_DIR}," >&2
      echo "[handla-production-deploy]        but referenced historical Docker images are missing from local storage." >&2
      exit 9
    fi

    # Verify database backup exists and passes integrity checks
    if [ ! -f "$BACKUP_SUCCESS_MARKER" ]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: database backup marker missing (${BACKUP_SUCCESS_MARKER})." >&2
      echo "[handla-production-deploy]        A valid database backup must exist before first deployment." >&2
      exit 9
    fi

    if [ ! -f "$BACKUP_SUCCESS_META" ]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: database backup metadata missing (${BACKUP_SUCCESS_META})." >&2
      exit 9
    fi

    # Parse KEY=VALUE metadata format (/var/lib/handla-backup/last-success.meta)
    backup_ts="$(cat "$BACKUP_SUCCESS_MARKER" | tr -d '[:space:]')"
    backup_meta_ts="$(grep -m1 '^ts=' "$BACKUP_SUCCESS_META" | cut -d= -f2- | tr -d '[:space:]' || true)"
    backup_db_artifact="$(grep -m1 '^db_artifact=' "$BACKUP_SUCCESS_META" | cut -d= -f2- | tr -d '[:space:]' || true)"
    backup_db_size="$(grep -m1 '^db_size=' "$BACKUP_SUCCESS_META" | cut -d= -f2- | tr -d '[:space:]' || true)"
    backup_db_sha="$(grep -m1 '^db_sha256=' "$BACKUP_SUCCESS_META" | cut -d= -f2- | tr -d '[:space:]' || true)"
    backup_remote="$(grep -m1 '^remote=' "$BACKUP_SUCCESS_META" | cut -d= -f2- | tr -d '[:space:]' || true)"

    if [ -z "$backup_ts" ] || [ -z "$backup_meta_ts" ] || [ -z "$backup_db_artifact" ] || \
       [ -z "$backup_db_size" ] || [ -z "$backup_db_sha" ] || [ -z "$backup_remote" ]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: database backup metadata is corrupt or incomplete." >&2
      exit 9
    fi

    # Fail closed if last-success timestamp and metadata timestamp diverge
    if [ "$backup_ts" != "$backup_meta_ts" ]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: backup marker timestamp ('$backup_ts') does not match metadata ts ('$backup_meta_ts')." >&2
      exit 9
    fi

    # Verify db_size is a positive integer
    if ! [[ "$backup_db_size" =~ ^[1-9][0-9]*$ ]]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: database backup size is invalid ('$backup_db_size')." >&2
      exit 9
    fi

    # Verify db_sha256 is a 64-char hex string
    if ! [[ "$backup_db_sha" =~ ^[0-9a-fA-F]{64}$ ]]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: database backup SHA256 checksum is invalid ('$backup_db_sha')." >&2
      exit 9
    fi

    # Verify remote points to an approved AWS backup destination
    if ! grep -q '^remote=handla-backups-aws:' "$BACKUP_SUCCESS_META" 2>/dev/null; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: backup remote ('$backup_remote') is not AWS (handla-backups-aws:)." >&2
      exit 9
    fi

    # Verify remote metadata path structure (daily/<timestamp>)
    if [[ ! "$backup_remote" =~ ^handla-backups-aws:.+/daily/ ]]; then
      echo "[handla-production-deploy] FATAL: first-deployment mode rejected: backup remote prefix is malformed ('$backup_remote')." >&2
      exit 9
    fi

    # Note: The encrypted backup artifact is securely uploaded to off-host S3 storage and is NOT
    # required to exist in local /opt/handla-backup/local on the VPS. We do not download the full artifact
    # during deploy; we verify the remote layout metadata and local marker integrity.

    FIRST_DEPLOY_NO_BASELINE=1
    log "First-deployment mode ELIGIBLE ✓ (no historical baseline, app containers stopped, DB backup verified: artifact=${backup_db_artifact}, size=${backup_db_size} bytes, remote=${backup_remote})"
  else
    # Partial availability (one exists, one missing): invalid state
    echo "[handla-production-deploy] FATAL: asymmetric historical Docker images detected (api_exists=${api_exists}, web_exists=${web_exists})." >&2
    echo "[handla-production-deploy]        Cannot establish a coherent rollback baseline. Aborting." >&2
    exit 9
  fi
fi

# Validate that the rollback image targets actually exist in local Docker storage (if baseline required)
if [ "$FIRST_DEPLOY_NO_BASELINE" -eq 1 ]; then
  log "Operating in first-deployment mode: skipping pre-deployment rollback image pinning."
else
  if [ -z "$ROLLBACK_TARGET_API" ] || [ -z "$ROLLBACK_TARGET_WEB" ]; then
    echo "[handla-production-deploy] FATAL: no valid rollback target images determined and not eligible for first-deployment mode." >&2
    exit 9
  fi

  if ! "$DOCKER" image inspect "$ROLLBACK_TARGET_API" >/dev/null 2>&1; then
    echo "[handla-production-deploy] FATAL: rollback target API image '$ROLLBACK_TARGET_API' does not exist in local Docker storage." >&2
    echo "[handla-production-deploy]        Cannot establish a recoverable rollback state. Aborting." >&2
    exit 9
  fi

  if ! "$DOCKER" image inspect "$ROLLBACK_TARGET_WEB" >/dev/null 2>&1; then
    echo "[handla-production-deploy] FATAL: rollback target Web image '$ROLLBACK_TARGET_WEB' does not exist in local Docker storage." >&2
    echo "[handla-production-deploy]        Cannot establish a recoverable rollback state. Aborting." >&2
    exit 9
  fi

  # Ensure rollback targets are tagged so 'docker image prune' never deletes them
  "$DOCKER" tag "$ROLLBACK_TARGET_API" handla-api:rollback 2>/dev/null || true
  "$DOCKER" tag "$ROLLBACK_TARGET_WEB" handla-web:rollback 2>/dev/null || true
  log "Pinned rollback targets (api=${ROLLBACK_TARGET_API}, web=${ROLLBACK_TARGET_WEB}) to tag :rollback"

  # Ensure the emergency rollback compose override points to the verified recovery baseline
  install -d -m 0700 -o root -g root "$ROLLBACK_DIR"
  cat <<EOF > "$ROLLBACK_OVERRIDE"
# AUTO-GENERATED by handla-production-deploy
# Restores exact image IDs from last verified deployment.
services:
  api:
    image: ${ROLLBACK_TARGET_API}
  web:
    image: ${ROLLBACK_TARGET_WEB}
EOF
  chmod 600 "$ROLLBACK_OVERRIDE"
  log "Durable emergency rollback compose override ensured -> $ROLLBACK_OVERRIDE (points to recovery baseline)"

  # Initialize metadata file on first deployment with existing baseline if absent
  if [ ! -f "$ROLLBACK_METADATA" ]; then
    cat <<EOF > "$ROLLBACK_METADATA"
{
  "last_updated": "$(date -u +%FT%TZ)",
  "status": "${ROLLBACK_BASELINE_STATUS}",
  "known_good_api_image": "${ROLLBACK_TARGET_API}",
  "known_good_web_image": "${ROLLBACK_TARGET_WEB}",
  "previous_api_image": "${ROLLBACK_TARGET_API}",
  "previous_web_image": "${ROLLBACK_TARGET_WEB}",
  "caller": "${CALLER}"
}
EOF
    chmod 600 "$ROLLBACK_METADATA"
    log "Initialized rollback metadata -> $ROLLBACK_METADATA (status=${ROLLBACK_BASELINE_STATUS})"
  fi
fi

# ---- 11. Run database migrations BEFORE stopping old API -------------------
log "Executing database migrations via one-off runner container..."
# Run a one-off container from the newly built api image.
# We override the entrypoint with `node` to run migrations directly:
#   1. Guaranteed to exit 0 on success and exit 1 on failure.
#   2. Completely independent of whether the old or new entrypoint.sh is in the image.
#   3. Never starts the NestJS API server.
#   4. Inherits the migrator credentials injected from .env.
MIGRATION_RUNNER_CMD="
const { AppDataSource } = require('./dist/config/data-source');
AppDataSource.initialize()
  .then(() => AppDataSource.runMigrations({ transaction: 'all' }))
  .then((ran) => {
    console.log('[migration-runner] Migrations applied:', ran.length ? ran.map(m => m.name).join(', ') : 'none (already up-to-date)');
    return AppDataSource.destroy();
  })
  .then(() => process.exit(0))
  .catch((err) => {
    console.error('[migration-runner] Migration failed:', err.message);
    process.exit(1);
  });
"

if ! "$DOCKER" compose "${COMPOSE_ARGS[@]}" run --rm --no-deps \
  --entrypoint node \
  api -e "$MIGRATION_RUNNER_CMD"; then
  echo "[handla-production-deploy] FATAL: Database migration runner failed." >&2
  echo "[handla-production-deploy]        Aborting deployment. Existing application was NOT modified." >&2
  exit 7
fi
log "Database migrations completed successfully ✓"

# ---- 12. Deploy new application containers (api, web) -----------------------
log "Deploying new api and web containers..."
# Mark application containers as in-progress. If docker compose up fails partially
# or exits with an error, the trap or error handler will ensure both application
# containers are stopped and verified, never left half-running.
APP_DEPLOY_IN_PROGRESS=1

# Only recreate api and web — leave mysql and redis untouched.
if ! "$DOCKER" compose "${COMPOSE_ARGS[@]}" up -d --no-deps --force-recreate api web; then
  echo "[handla-production-deploy] FATAL: 'docker compose up' failed for application containers (api, web)." >&2
  cleanup_application_containers
  exit 8
fi

# ---- 13. Health verification ------------------------------------------------
log "Verifying new API health (container healthcheck + HTTP 200 probe)..."
API_HEALTHY=0
for i in $(seq 1 30); do
  c_health="$("$DOCKER" inspect --format='{{json .State.Health.Status}}' handla_api 2>/dev/null || echo '"unknown"')"

  # Verify HTTP 200 status code directly
  http_code=0
  curl_code="$(curl -sf -o /dev/null -w "%{http_code}" --max-time 3 http://127.0.0.1:3001/api/health 2>/dev/null || true)"
  if [ "$curl_code" = "200" ]; then
    http_code=200
  elif [ -x "$NODE" ] && "$NODE" -e 'const http = require("http"); const req = http.get("http://127.0.0.1:3001/api/health", { timeout: 3000 }, (res) => process.exit(res.statusCode === 200 ? 0 : 1)); req.on("error", () => process.exit(1)); req.on("timeout", () => { req.destroy(); process.exit(1); });' 2>/dev/null; then
    http_code=200
  elif "$DOCKER" exec handla_api wget -q -S --spider http://127.0.0.1:3001/api/health 2>&1 | grep -Eq 'HTTP/[0-9.]+ 200'; then
    http_code=200
  fi

  if [ "$c_health" = '"healthy"' ] && [ "$http_code" -eq 200 ]; then
    API_HEALTHY=1
    log "API health check passed ✓ (HTTP 200 OK & container healthy, attempt ${i})"
    break
  fi
  sleep 2
done

if [ "$API_HEALTHY" -ne 1 ]; then
  echo "[handla-production-deploy] FATAL: API health check failed after 60s." >&2
  echo "[handla-production-deploy] Logs from handla_api:" >&2
  "$DOCKER" logs --tail 50 handla_api >&2 || true
  cleanup_application_containers
  exit 8
fi

log "Verifying new Web frontend responsiveness (HTTP 200 probe)..."
WEB_HEALTHY=0
for i in $(seq 1 20); do
  # Probe frontend to verify Next.js server readiness with an explicit HTTP 200 check
  web_http_code=0
  curl_code="$(curl -sf -o /dev/null -w "%{http_code}" --max-time 3 http://127.0.0.1:3000/ 2>/dev/null || true)"
  if [ "$curl_code" = "200" ]; then
    web_http_code=200
  elif [ -x "$NODE" ] && "$NODE" -e 'const http = require("http"); const req = http.get("http://127.0.0.1:3000/", { timeout: 3000 }, (res) => process.exit(res.statusCode === 200 ? 0 : 1)); req.on("error", () => process.exit(1)); req.on("timeout", () => { req.destroy(); process.exit(1); });' 2>/dev/null; then
    web_http_code=200
  elif "$DOCKER" exec handla_web node -e 'const http = require("http"); const req = http.get("http://127.0.0.1:3000/", { timeout: 3000 }, (res) => process.exit(res.statusCode === 200 ? 0 : 1)); req.on("error", () => process.exit(1)); req.on("timeout", () => { req.destroy(); process.exit(1); });' 2>/dev/null; then
    web_http_code=200
  elif "$DOCKER" exec handla_web wget -q -S --spider http://127.0.0.1:3000/ 2>&1 | grep -Eq 'HTTP/[0-9.]+ 200'; then
    web_http_code=200
  fi

  if [ "$web_http_code" -eq 200 ]; then
    WEB_HEALTHY=1
    log "Frontend server responding ✓ (HTTP 200 OK, attempt ${i})"
    break
  fi
  sleep 2
done

if [ "$WEB_HEALTHY" -ne 1 ]; then
  echo "[handla-production-deploy] FATAL: Web container failed HTTP responsiveness check after 40s." >&2
  echo "[handla-production-deploy] Logs from handla_web:" >&2
  "$DOCKER" logs --tail 50 handla_web >&2 || true
  cleanup_application_containers
  exit 8
fi

# Both containers verified healthy: mark deploy completed so normal exit does not trigger cleanup
APP_DEPLOY_IN_PROGRESS=0

# ---- 14. Record verified deployment & update rollback metadata -------------
# Only after both API and Web have passed all health checks and are confirmed
# serving HTTP 200 do we update the durable rollback reference to point to the
# previously verified state and save the new successfully deployed image IDs.
NEW_DEPLOYED_API_IMAGE="$("$DOCKER" inspect --format='{{.Image}}' handla_api 2>/dev/null || true)"
NEW_DEPLOYED_WEB_IMAGE="$("$DOCKER" inspect --format='{{.Image}}' handla_web 2>/dev/null || true)"

install -d -m 0700 -o root -g root "$ROLLBACK_DIR"

if [ "$FIRST_DEPLOY_NO_BASELINE" -eq 1 ]; then
  # Successful first deployment without prior baseline:
  # The newly verified release establishes the initial active baseline.
  # We do not fabricate a fictitious prior image, but record the verified state
  # and point the rollback override to the newly verified release so that future
  # deployments can reliably restore or roll back to this known-good release.
  "$DOCKER" tag "$NEW_DEPLOYED_API_IMAGE" handla-api:rollback 2>/dev/null || true
  "$DOCKER" tag "$NEW_DEPLOYED_WEB_IMAGE" handla-web:rollback 2>/dev/null || true

  cat <<EOF > "$ROLLBACK_OVERRIDE"
# AUTO-GENERATED by handla-production-deploy upon verified healthy first deployment of ${BRANCH}@${DEPLOY_SHA}
# Establishes initial verified baseline for subsequent deployments.
services:
  api:
    image: ${NEW_DEPLOYED_API_IMAGE}
  web:
    image: ${NEW_DEPLOYED_WEB_IMAGE}
EOF
  chmod 600 "$ROLLBACK_OVERRIDE"

  cat <<EOF > "$ROLLBACK_METADATA"
{
  "timestamp": "$(date -u +%FT%TZ)",
  "deployed_branch": "${BRANCH}",
  "deployed_sha": "${DEPLOY_SHA}",
  "status": "healthy_verified_initial",
  "active_api_image": "${NEW_DEPLOYED_API_IMAGE}",
  "active_web_image": "${NEW_DEPLOYED_WEB_IMAGE}",
  "known_good_api_image": "${NEW_DEPLOYED_API_IMAGE}",
  "known_good_web_image": "${NEW_DEPLOYED_WEB_IMAGE}",
  "previous_api_image": null,
  "previous_web_image": null,
  "caller": "${CALLER}"
}
EOF
  chmod 600 "$ROLLBACK_METADATA"
  log "Persisted verified initial baseline metadata and rollback override -> $ROLLBACK_DIR (status=healthy_verified_initial)"
else
  if [ -n "$ROLLBACK_TARGET_API" ] && [ -n "$ROLLBACK_TARGET_WEB" ]; then
    cat <<EOF > "$ROLLBACK_OVERRIDE"
# AUTO-GENERATED by handla-production-deploy upon verified healthy deployment of ${BRANCH}@${DEPLOY_SHA}
# Restores exact image IDs from prior working deployment.
services:
  api:
    image: ${ROLLBACK_TARGET_API}
  web:
    image: ${ROLLBACK_TARGET_WEB}
EOF
    chmod 600 "$ROLLBACK_OVERRIDE"
  fi

  cat <<EOF > "$ROLLBACK_METADATA"
{
  "timestamp": "$(date -u +%FT%TZ)",
  "deployed_branch": "${BRANCH}",
  "deployed_sha": "${DEPLOY_SHA}",
  "status": "healthy_verified",
  "active_api_image": "${NEW_DEPLOYED_API_IMAGE}",
  "active_web_image": "${NEW_DEPLOYED_WEB_IMAGE}",
  "known_good_api_image": "${ROLLBACK_TARGET_API}",
  "known_good_web_image": "${ROLLBACK_TARGET_WEB}",
  "previous_api_image": "${ROLLBACK_TARGET_API}",
  "previous_web_image": "${ROLLBACK_TARGET_WEB}",
  "caller": "${CALLER}"
}
EOF
  chmod 600 "$ROLLBACK_METADATA"
  log "Persisted verified rollback metadata and compose override -> $ROLLBACK_DIR (status=healthy_verified)"
fi

# ---- 15. Prune dangling images & report status -------------------------------
log "Pruning dangling images..."
"$DOCKER" image prune -f >/dev/null 2>&1 || true

log "Current status:"
"$DOCKER" compose "${COMPOSE_ARGS[@]}" ps

log "Done ✓  Deployed ${BRANCH}@${DEPLOY_SHA} (initiated by '${CALLER}')."
