# =============================================================================
# handla-monitor-summary.service  —  writes the daily local security summary.
# INSTALL: /etc/systemd/system/handla-monitor-summary.service
# Driven by handla-monitor-summary.timer (once daily).
# =============================================================================
[Unit]
Description=HANDLA daily local monitoring summary
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/handla-monitor summary
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/handla-monitor
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
