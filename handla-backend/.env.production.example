# =============================================================================
# Handla Backend — PRODUCTION environment template (VPS + Docker Compose)
# =============================================================================
# Copy to `handla-backend/.env` ON THE VPS and fill in the real secret values.
# NEVER commit the filled-in .env. This template contains NO secrets.
#
# Notes for the Dockerised VPS deploy:
#   - DATABASE_HOST / REDIS_HOST are OVERRIDDEN by docker-compose to the service
#     names (mysql / redis) — you do NOT need to set them here.
#   - NODE_ENV is forced to `production` by the compose file.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Public base URL used in outbound email links. MUST be the real frontend URL.
BASE_URL=https://handla.tech

# ─── Database (MySQL 8, containerised) ───────────────────────────────────────
# Host/port are set by compose (mysql:3306). Only names + passwords needed here.
DATABASE_NAME=handla_db
# Use a DEDICATED user, NOT root, in production.
DATABASE_USER=handla
DATABASE_PASSWORD=__SET_A_STRONG_DB_PASSWORD__
# Root password is used only by the mysql:8 image bootstrap.
DATABASE_ROOT_PASSWORD=__SET_A_STRONG_ROOT_PASSWORD__
# NEVER true in production — all schema changes go through TypeORM migrations,
# which the api entrypoint runs automatically on startup.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate fresh 64-char hex secrets, e.g.:  openssl rand -hex 32
JWT_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
JWT_EXPIRATION=900
JWT_REFRESH_SECRET=__GENERATE_A_DIFFERENT_openssl_rand_hex_32__
JWT_REFRESH_EXPIRATION=604800

# ─── Redis (Bull email queue) ─────────────────────────────────────────────────
# Host/port set by compose (redis:6379). Leave REDIS_URL unset for the VPS.
# REDIS_URL=

# ─── AWS S3 (file uploads) ───────────────────────────────────────────────────
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=__YOUR_AWS_ACCESS_KEY_ID__
AWS_SECRET_ACCESS_KEY=__YOUR_AWS_SECRET_ACCESS_KEY__
AWS_S3_BUCKET=handla-uploads
AWS_S3_PRESIGNED_URL_EXPIRY=900
AWS_S3_KEY_PREFIX=handla

# ─── Email (Nodemailer / SMTP — Hostinger) ────────────────────────────────────
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=admin@handla.tech
MAIL_PASS=__YOUR_HOSTINGER_MAILBOX_PASSWORD__
MAIL_FROM=support@handla.tech
MAIL_FROM_NAME=Handla Support
MAIL_REPLY_TO=support@handla.tech

# ─── CORS / WebSocket ─────────────────────────────────────────────────────────
# MUST be the real frontend origin (no trailing slash).
SOCKET_CORS_ORIGIN=https://handla.tech

# ─── Rate limiting / hardening ────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
BCRYPT_ROUNDS=12
BODY_LIMIT=1mb

# ─── AI Handla Assistant ──────────────────────────────────────────────────────
OPENAI_API_KEY=__YOUR_OPENAI_API_KEY__
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=600
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_MS=20000
AI_ASSISTANT_ENABLED=true
AI_RECENT_WINDOW=12
AI_MAX_KB_SNIPPETS=6

# ─── SaaS Control Plane ───────────────────────────────────────────────────────
# Real provisioning is not wired yet -> keep the safe in-process mock for now.
SAAS_USE_MOCK=true
SAAS_INTERNAL_INBOUND_KEY=
SAAS_OUTBOUND_KEY_MUDAR=
SAAS_OUTBOUND_KEY_MATJARI=
SAAS_OUTBOUND_KEY_MANARA=
SAAS_OUTBOUND_KEY_DEFAULT=
SAAS_PROVISION_TIMEOUT_MS=20000
SAAS_ROOT_ZONE=handla.tech
SAAS_WORKER_INTERVAL_MS=5000
SAAS_MAX_ATTEMPTS=3

# ─── Initial admin seed ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@handla.tech
ADMIN_PASSWORD=__SET_A_STRONG_ADMIN_PASSWORD__
ADMIN_NAME=Handla Admin

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=__YOUR_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__YOUR_GOOGLE_CLIENT_SECRET__
# PRODUCTION redirect URI — must be registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://api.handla.tech/api/auth/google/callback
# Frontend origin the OAuth callback bounces back to.
FRONTEND_URL=https://handla.tech

# ─── DANGER — must be false/absent in production ──────────────────────────────
# ALLOW_DB_RESET intentionally omitted. Do NOT set it on the VPS.
