# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
build/

# ─── Dependencies (reinstalled inside container) ─────────────────────────────
node_modules/

# ─── Environment files (never bake secrets into images) ──────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Test artifacts ──────────────────────────────────────────────────────────
coverage/
**/*.spec.ts
**/*.spec.js
**/*.e2e-spec.ts
test/
jest.config.*

# ─── Docker files (no need to copy into image) ───────────────────────────────
Dockerfile
Dockerfile.*
.dockerignore

# ─── Git & editor metadata ───────────────────────────────────────────────────
.git/
.gitignore
.github/
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ─── TypeScript sources (only compiled dist/ is needed at runtime) ────────────
# NOTE: src/ IS copied in the builder stage but excluded from the runtime stage
# via multi-stage build; no need to list here for the final image.
# This file controls what reaches the builder, so keep src/ available.

# ─── Misc ────────────────────────────────────────────────────────────────────
*.md
!README.md
.eslintrc*
.prettierrc*
