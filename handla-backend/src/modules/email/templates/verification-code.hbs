<!DOCTYPE html>
<html lang="{{lang}}" dir="{{dir}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{t.title}}</title>
  <style>
    body { margin: 0; padding: 0; background-color: #0a0a0a; font-family: 'Segoe UI', Tahoma, Arial, sans-serif; color: #e5e5e5; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #111111; border: 1px solid #262626; border-radius: 18px; overflow: hidden; }
    .header { background: #0a0a0a; padding: 36px 40px 28px; text-align: center; border-bottom: 1px solid #1f1f1f; }
    .logo { font-family: 'Courier New', monospace; font-weight: 800; font-size: 22px; letter-spacing: -0.5px; color: #ffffff; }
    .logo .slash { color: #fbbf24; }
    .body { padding: 36px 40px; text-align: {{align}}; }
    .greeting { font-size: 16px; color: #e5e5e5; margin: 0 0 8px; }
    .purpose { font-size: 14px; line-height: 1.7; color: #a3a3a3; margin: 0 0 28px; }
    .code-box { margin: 0 auto 24px; text-align: center; }
    .code { display: inline-block; background: #0a0a0a; border: 1px solid #fbbf2455; border-radius: 14px; padding: 18px 30px; font-family: 'Courier New', monospace; font-size: 40px; font-weight: 800; letter-spacing: 12px; color: #fbbf24; }
    .expiry { text-align: center; font-size: 13px; color: #737373; margin: 0 0 28px; }
    .security { font-size: 12.5px; line-height: 1.7; color: #737373; background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; padding: 16px 18px; }
    .footer { text-align: center; color: #525252; font-size: 12px; padding: 0 40px 30px; line-height: 1.7; }
    .footer a { color: #fbbf24; text-decoration: none; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <span class="logo">&lt;Handla <span class="slash">/</span>&gt;</span>
    </div>
    <div class="body">
      <p class="greeting">{{t.greeting}}</p>
      <p class="purpose">{{t.purpose}}</p>
      <div class="code-box">
        <span class="code">{{code}}</span>
      </div>
      <p class="expiry">{{t.expiry}}</p>
      <p class="security">{{t.security}}</p>
    </div>
    <div class="footer">
      <p>© {{year}} Handla. {{t.rights}}</p>
    </div>
  </div>
</body>
</html>
