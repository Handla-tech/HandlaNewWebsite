# ===========================
# HANDLA BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================

# ===========================
# Application
# ===========================
NODE_ENV=development
PORT=3001

# ===========================
# Database (PostgreSQL)
# ===========================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=handla_db
DATABASE_USER=handla
DATABASE_PASSWORD=password_change_in_prod
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true

# ===========================
# JWT Authentication
# ===========================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=900              # 15 minutes in seconds
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=604800   # 7 days in seconds

# ===========================
# AWS S3 (File Uploads)
# ===========================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=handla-uploads
# Presigned URL expiry in seconds (15 minutes)
AWS_S3_PRESIGNED_URL_EXPIRY=900

# ===========================
# Email (Nodemailer / Gmail SMTP)
# For Gmail: use App Password (not account password)
# Generate at: https://myaccount.google.com/apppasswords
# ===========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM=no-reply@handla.com

# ===========================
# Email (AWS SES — Alternative)
# Uncomment and use instead of Gmail if preferred
# ===========================
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USER=your_ses_smtp_username
# MAIL_PASS=your_ses_smtp_password
# MAIL_FROM=no-reply@handla.com

# ===========================
# Socket.io / CORS
# ===========================
SOCKET_CORS_ORIGIN=http://localhost:3000
# For production: SOCKET_CORS_ORIGIN=https://yourdomain.com

# ===========================
# Bull Queue (Redis — optional for production)
# If not set, Bull uses in-memory queue (dev only)
# ===========================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ===========================
# Rate Limiting
# ===========================
THROTTLE_TTL=60000       # 1 minute in ms
THROTTLE_LIMIT=100       # max requests per TTL
AUTH_THROTTLE_TTL=900000 # 15 minutes in ms
AUTH_THROTTLE_LIMIT=5    # max login attempts per TTL
