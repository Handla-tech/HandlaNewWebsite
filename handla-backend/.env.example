# =============================================================================
# Handla Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all required values before starting.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults shown.
# =============================================================================


# ─── Application ─────────────────────────────────────────────────────────────

# HTTP port the NestJS API listens on
# Default: 3001
PORT=3001

# Runtime environment (development | staging | production)
# Controls: Swagger visibility, CSP headers
# Default: development
NODE_ENV=development

# Public base URL of the frontend (used in email links)
# [REQUIRED in production]
# Default: https://handla.com
BASE_URL=https://handla.com


# ─── Database (MySQL 8) ──────────────────────────────────────────────────────

# Hostname of the MySQL server
# In Docker: use the service name (e.g. "mysql")
# Default: localhost
DATABASE_HOST=localhost

# MySQL port
# Default: 3306
DATABASE_PORT=3306

# Database name
# Default: handla_db
DATABASE_NAME=handla_db

# Database username
# Default: handla
DATABASE_USER=handla

# Database password [REQUIRED]
DATABASE_PASSWORD=change_me_in_production

# MySQL root password [REQUIRED for Docker — used by mysql:8.0 image]
DATABASE_ROOT_PASSWORD=change_me_root_password

# Auto-sync schema from entities (DANGER: data loss in production — use migrations instead)
# MUST remain false — this project uses TypeORM migrations for all DDL changes.
# Setting this to true will cause startup crashes when migration-managed constraints
# (e.g. uq_conversations_client_admin) exist in the DB but TypeORM tries to drop/recreate them.
# Default: false
DATABASE_SYNCHRONIZE=false

# Enable verbose SQL query logging
# Default: false
DATABASE_LOGGING=false


# ─── JWT Authentication ───────────────────────────────────────────────────────

# Secret for signing access tokens (HS256) [REQUIRED — min 32 chars]
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Access token lifetime in seconds
# Default: 900 (15 minutes)
JWT_EXPIRATION=900

# Secret for signing refresh tokens [REQUIRED — min 32 chars, different from JWT_SECRET]
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Refresh token lifetime in seconds
# Default: 604800 (7 days)
JWT_REFRESH_EXPIRATION=604800


# ─── Redis (Bull email queue) ─────────────────────────────────────────────────

# Full Redis connection URL — takes priority over REDIS_HOST/PORT if set
# Example: redis://:password@redis.example.com:6379/0
# REDIS_URL=

# Redis hostname (used when REDIS_URL is not set)
# In Docker: use the service name (e.g. "redis")
# Default: localhost
REDIS_HOST=localhost

# Redis port
# Default: 6379
REDIS_PORT=6379


# ─── AWS S3 (file uploads) ───────────────────────────────────────────────────

# AWS region where your S3 bucket lives
# Default: us-east-1
AWS_REGION=us-east-1

# IAM access key ID [REQUIRED for file uploads]
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# IAM secret access key [REQUIRED for file uploads]
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 bucket name for user file uploads
# Default: handla-uploads
AWS_S3_BUCKET=handla-uploads

# Presigned URL expiry in seconds
# Default: 900 (15 minutes) — must be ≤ 604800 (7 days)
AWS_S3_PRESIGNED_URL_EXPIRY=900


# ─── Email (Nodemailer / SMTP) ────────────────────────────────────────────────

# SMTP hostname
# Default: smtp.gmail.com
MAIL_HOST=smtp.gmail.com

# SMTP port (587 = STARTTLS, 465 = SSL/TLS)
# Default: 587
MAIL_PORT=587

# Use TLS from the start (true for port 465, false for 587 STARTTLS)
# Default: false
MAIL_SECURE=false

# SMTP login username (usually your email address) [REQUIRED]
MAIL_USER=your_smtp_username@gmail.com

# SMTP login password or app password [REQUIRED]
MAIL_PASS=your_smtp_app_password

# The "From" address shown in outgoing emails
# Default: no-reply@handla.com
MAIL_FROM=no-reply@handla.com


# ─── CORS / WebSocket ─────────────────────────────────────────────────────────

# Allowed origin for CORS and Socket.io connections
# In production: set to your frontend domain (no trailing slash)
# Default: http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000


# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Time window in milliseconds for rate limiting
# Default: 60000 (60 seconds)
THROTTLE_TTL=60000

# Maximum number of requests per window per IP
# Default: 100
# NOTE: rate limiting is enforced globally via ThrottlerGuard (APP_GUARD).
# Auth login/register additionally have stricter per-route @Throttle limits.
THROTTLE_LIMIT=100


# ─── Hardening (security / performance) ───────────────────────────────────────

# bcrypt cost factor for password hashing. Default 12 (OWASP baseline).
# Raise for stronger hashing at the cost of more CPU per login.
BCRYPT_ROUNDS=12

# Max request body size for JSON / urlencoded payloads (large-payload DoS guard).
# Default: 1mb. Use dedicated multipart handling for legitimate large uploads.
BODY_LIMIT=1mb


# ─── AI Handla Assistant (Phase 10) ───────────────────────────────────────────

# OpenAI API key. Leave EMPTY to keep the AI assistant DISABLED (graceful no-op).
# The chatbot only activates when this key is present and AI_ASSISTANT_ENABLED != false.
OPENAI_API_KEY=

# Chat completion model. Must support JSON response_format.
# Default: gpt-4o-mini (small, cheap, JSON-capable)
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible base URL (override for Azure / proxy).
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Hard ceiling on completion length (cost control). Default: 600
OPENAI_MAX_TOKENS=600

# Sampling temperature. Low values reduce hallucination. Default: 0.2
OPENAI_TEMPERATURE=0.2

# Per-request timeout in ms; after this the bot falls back gracefully. Default: 20000
OPENAI_TIMEOUT_MS=20000

# Master switch. Set to "false" to mute the bot globally even with a key set.
AI_ASSISTANT_ENABLED=true

# Number of recent messages fed verbatim into the prompt. Default: 12
AI_RECENT_WINDOW=12

# Max Knowledge Base snippets injected into a single prompt. Default: 6
AI_MAX_KB_SNIPPETS=6

# ─────────────────────────────────────────────────────────────────────────────
# SaaS Control Plane (Phase 11) — Handla as managed provisioning control plane
# ─────────────────────────────────────────────────────────────────────────────

# Shared secret products MUST present (Authorization: Bearer / X-Internal-Key)
# when calling Handla's @Public() internal callback endpoints. Empty ⇒ the
# internal API is DISABLED (fail closed).
SAAS_INTERNAL_INBOUND_KEY=

# Outbound service-to-service keys Handla presents to each product, keyed by
# product code. Never persisted in the DB (only a SHA-256 hash is, for display).
SAAS_OUTBOUND_KEY_MUDAR=
SAAS_OUTBOUND_KEY_MATJARI=
SAAS_OUTBOUND_KEY_MANARA=

# Fallback outbound key used when a product-specific one is not set.
SAAS_OUTBOUND_KEY_DEFAULT=

# Per-request timeout (ms) for outbound provisioning calls. Default: 20000
SAAS_PROVISION_TIMEOUT_MS=20000

# Root DNS zone for tenant subdomains (*.<product>.<root>). Default: handla.tech
SAAS_ROOT_ZONE=handla.tech

# How often (ms) the background provisioning worker polls for queued jobs. Default: 5000
SAAS_WORKER_INTERVAL_MS=5000

# Max attempts before a provisioning job is marked FAILED. Default: 3
SAAS_MAX_ATTEMPTS=3

# When "true" (default), products without a wired real endpoint use the safe
# in-process "mock" provisioner (handy for local/dev). Set "false" in prod.
SAAS_USE_MOCK=true

# =============================================================================
# ─── Auth: Google OAuth + Email OTP (2026-08 two-step auth) ──────────────────
# =============================================================================

# Public base URL of the frontend. The Google callback redirects the browser
# back to `${FRONTEND_URL}/auth` to show the OTP screen. [REQUIRED in prod]
# Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Google Sign-In (server-side OAuth 2.0 authorization-code flow) ──────────
# Create an OAuth 2.0 "Web application" client at:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below.
# Leave blank to disable Google sign-in (the button will return a config error).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered in the Google Cloud Console.
# Default: http://localhost:3001/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ─── Email OTP tuning (sensible secure defaults — override only if needed) ───
# Number of digits in the verification code. Default: 6
OTP_LENGTH=6
# Code lifetime in seconds (5–10 min recommended). Default: 600 (10 min)
OTP_TTL_SECONDS=600
# Max wrong attempts before the code is burned. Default: 5
OTP_MAX_ATTEMPTS=5
# Seconds a user must wait before requesting a new code. Default: 45
OTP_RESEND_COOLDOWN_SECONDS=45
